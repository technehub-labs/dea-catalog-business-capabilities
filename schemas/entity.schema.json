{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-catalog-business-capabilities/schemas/entity.schema.json",
  "title": "Business Capability Catalog Entry",
  "description": "Schema for entries in technehub-labs/dea-catalog-business-capabilities. Mirrors technehub-labs/dea-metamodel/schemas/entities/capability.json conventions; catalog extensions per docs/FOUNDATIONS.md section 12 as amended by CR-DEA-BC-01A. Established by CR-DEA-BC-03.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "name",
    "definition",
    "version",
    "outcome",
    "business_object",
    "ecf",
    "evidence",
    "provenance",
    "why_capability",
    "boundary",
    "non_examples",
    "specialization_boundary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^dea:capability-[a-z0-9-]+$",
      "examples": ["dea:capability-customer-management"]
    },
    "type": {
      "type": "string",
      "const": "BusinessCapability",
      "description": "Kind by entity specialization (dea-metamodel ADR-015): every entry in this catalog is a dea:BusinessCapability by catalog scope. capability_type is deprecated upstream and never appears here (CR-DEA-BC-01A)."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "definition": {
      "type": "string",
      "maxLength": 2000,
      "description": "Durable-ability definition per METHODOLOGY.md section 1."
    },
    "purpose": { "type": "string", "maxLength": 2000 },
    "outcome": {
      "type": "string",
      "maxLength": 2000,
      "description": "The meaningful business outcome this ability produces, enables, controls, preserves or realizes."
    },
    "business_object": {
      "type": "string",
      "maxLength": 200,
      "description": "The business object or domain the ability is concerned with (Object Focus test, METHODOLOGY.md section 4)."
    },
    "capability_layer": {
      "type": "string",
      "enum": ["strategic", "operational", "support"],
      "description": "Governed enumeration (dea-metamodel ADR-015 section 5, vocabulary E005). Optional."
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["proposed", "planned", "active", "deprecated", "retired"],
      "description": "Upstream lifecycle vocabulary (dea-metamodel metamodel/vocabularies/lifecycle.yaml)."
    },
    "maturity": {
      "type": "string",
      "description": "Optional. Upstream capability.json requires maturity_level without defining it or its vocabulary (CR-DEA-BC-03 finding U2); this catalog carries an optional annotation only and invents no scale."
    },
    "ecf": {
      "type": "object",
      "additionalProperties": false,
      "description": "ECF coordinates are classification metadata, never a kind classifier (CR-DEA-BC-01A). Primary marks earliest initiation (METHODOLOGY.md section 8).",
      "properties": {
        "primary": { "$ref": "#/definitions/ecf_coordinate" },
        "secondary": {
          "type": "array",
          "items": { "$ref": "#/definitions/ecf_coordinate" },
          "description": "Legitimate participation in other stages; honest, not exhaustive."
        },
        "held_unmapped": {
          "type": "boolean",
          "description": "True when the mapping is legitimately absent (CR-DEA-BC-02 section 38 clause; CAND-019 precedent)."
        },
        "note": { "type": "string", "maxLength": 1000 }
      },
      "if": {
        "properties": { "held_unmapped": { "const": true } },
        "required": ["held_unmapped"]
      },
      "then": {
        "required": ["note"],
        "not": { "required": ["primary"] }
      },
      "else": {
        "required": ["primary"]
      }
    },
    "parents": {
      "type": "array",
      "items": { "type": "string", "pattern": "^dea:capability-[a-z0-9-]+$" }
    },
    "children": {
      "type": "array",
      "items": { "type": "string", "pattern": "^dea:capability-[a-z0-9-]+$" }
    },
    "related_capabilities": {
      "type": "array",
      "items": { "type": "string", "pattern": "^dea:capability-[a-z0-9-]+$" }
    },
    "realization": {
      "type": "object",
      "additionalProperties": false,
      "description": "Links to constructs in sibling catalogs; realization never redefines the capability (METHODOLOGY.md section 3).",
      "properties": {
        "processes": { "type": "array", "items": { "type": "string" } },
        "actors": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "array", "items": { "type": "string" } },
        "systems": { "type": "array", "items": { "type": "string" } },
        "information": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "rationale"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^SRC-[0-9]{3}$" },
          "description": "References into docs/research/evidence-register.yaml."
        },
        "rationale": { "type": "string", "maxLength": 2000 }
      }
    },
    "specialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed"],
      "properties": {
        "allowed": { "type": "boolean" },
        "industry_examples": { "type": "array", "items": { "type": "string" } }
      }
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Alternate names reconciled by normalization decisions (TAXONOMY.md section 2). An alias never becomes a separate entry."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ladder_passage"],
      "description": "Recorded passage through the seven-stage evidence ladder (METHODOLOGY.md section 6); admission goes through the review gates (section 12).",
      "properties": {
        "ladder_passage": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "date", "actor"],
            "properties": {
              "stage": {
                "type": "string",
                "enum": ["candidate", "observed", "corroborated", "normalized", "ecf-mapped", "reviewed", "canonical"]
              },
              "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "actor": { "type": "string" }
            }
          }
        },
        "candidate_ref": {
          "type": "string",
          "pattern": "^CAND-[0-9]{3}$",
          "description": "Origin in the candidate universe (docs/research/candidates.yaml)."
        },
        "normalization_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^N-[0-9]{3}$" }
        }
      }
    },
    "why_capability": {
      "type": "string",
      "maxLength": 2000,
      "description": "Why this is a durable ability rather than a process, unit, or technology (METHODOLOGY.md section 11)."
    },
    "ecf_rationale": {
      "type": "string",
      "maxLength": 1000,
      "description": "Why the primary coordinate is what it is."
    },
    "boundary": {
      "type": "string",
      "maxLength": 2000,
      "description": "What the capability includes and excludes."
    },
    "non_examples": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Adjacent constructs explicitly out of scope (process, system, organization, outcome)."
    },
    "specialization_boundary": {
      "type": "string",
      "maxLength": 1000,
      "description": "What industry specializations may legitimately refine (TAXONOMY.md section 4)."
    },
    "ecfConformance": {
      "type": "object",
      "description": "ECF Conformance Gate manifest (CR-ECF-CG-001..003). Declares the catalog's CONFORMANT-WITH-EXTENSION status, the canonical ECF references that resolve, and the catalog-specific extensions (kebab-case display vocabulary, multiple contextual coordinates, held-unmapped state). Schema-level shape is permissive; scripts/check_ecf_conformance.py enforces the contract.",
      "required": ["framework", "contractVersion", "profile", "status", "affiliation"],
      "properties": {
        "framework": { "type": "string", "const": "EnterpriseConceptFramework" },
        "contractVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "profile": { "type": "string", "pattern": "^dea:ecf@\\d+\\.\\d+\\.\\d+$" },
        "status": { "type": "string", "enum": ["conformant", "conformant-with-extension", "non-conformant", "not-yet-assessed"] },
        "affiliation": { "type": "string", "enum": ["mapped", "held-unmapped", "inherits-catalog"] },
        "rationaleRef": { "type": "string" },
        "canonicalReferences": { "type": "array" },
        "extensions": { "type": "array" }
      }
    },
    "external_references": {
      "type": "array",
      "description": "Identifiers in external systems. Never a substitute for the OpenDEA id.",
      "items": {
        "type": "object",
        "required": ["system", "identifier"],
        "properties": {
          "system": { "type": "string" },
          "identifier": { "type": "string" }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
  },
  "definitions": {
    "ecf_coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "stage"],
      "properties": {
        "domain": {
          "type": "string",
          "enum": [
            "governance-existence",
            "customer-demand",
            "supply-resources",
            "product-offering",
            "operations-delivery",
            "finance-value",
            "people-organization"
          ]
        },
        "stage": {
          "type": "string",
          "enum": ["conceive", "design", "build", "activate", "operate", "improve", "retire"]
        }
      }
    }
  }
}
